{
  "manifest_version": 3,
  "name": "Tidy",
  "version": "1.0.0",
  "description": "Sort loose tabs into groups by site, or by topic with optional AI.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:4872/*",
    "https://api.anthropic.com/*"
  ],
  "action": {
    "default_title": "Tidy",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "agrupar": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Alt+Shift+G"
      },
      "description": "Group loose tabs by topic"
    }
  },
  "options_page": "settings.html"
}